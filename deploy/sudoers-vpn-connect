# /etc/sudoers.d/vpn-connect  (mode 0440, check with: visudo -cf /etc/sudoers.d/vpn-connect)
# Lets the API's service user read WireGuard status — this exact command and nothing else.
# The API polls every few seconds, so don't log each call (wgmon can run nothing else).
Defaults:wgmon !log_allowed, !pam_session
wgmon ALL=(root) NOPASSWD: /usr/bin/wg show wg0 dump
