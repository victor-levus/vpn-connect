# ── Server ───────────────────────────────────────────────
NODE_ENV=development
# Bind to localhost only; Caddy is the only thing exposed publicly.
HOST=127.0.0.1
PORT=4000

# SQLite file, relative to prisma.config.ts (i.e. the server/ folder)
DATABASE_URL="file:./data/vpn.db"

# Comma-separated origins allowed to call the API (your Firebase Hosting URLs)
CORS_ORIGINS=http://localhost:5173,https://YOUR-PROJECT.web.app,https://YOUR-PROJECT.firebaseapp.com

# ── Auth ─────────────────────────────────────────────────
# Firebase project ID (used to verify ID tokens; no service account key needed)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Only these Google accounts may use the API (comma-separated)
ALLOWED_EMAILS=you@example.com
# Local development only: skip token checks. Ignored when NODE_ENV=production.
AUTH_DISABLED=false

# ── WireGuard ────────────────────────────────────────────
WG_INTERFACE=wg0
WG_BIN=/usr/bin/wg
# Run `wg` through `sudo -n` (needs the sudoers rule in deploy/)
WG_USE_SUDO=true
# Optional: read "# Name: ..." comments from the WireGuard config to name peers.
# Leave empty to name peers in the dashboard instead (recommended, see README).
WG_CONFIG_PATH=
# Fake peers for local development on a machine without WireGuard
WG_MOCK=false

# Poll interval and how recent a handshake must be to count as online
POLL_INTERVAL_SECONDS=15
ONLINE_THRESHOLD_SECONDS=180
