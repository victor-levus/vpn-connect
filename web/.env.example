# Backend base URL. Leave empty in development (Vite proxies /api to 127.0.0.1:4807).
# In .env.production set it to your VPS API, e.g. https://vpn-api.yourdomain.com
VITE_API_URL=

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These values are public by design; access is enforced by the backend's email allowlist.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Local development only: skip the Google login (backend must also have AUTH_DISABLED=true).
VITE_AUTH_DISABLED=false
